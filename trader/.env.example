# 複製這個檔案為 trader/.env 後填入（.env 已列在 .gitignore，不會提交到 GitHub）。
# 等號兩邊不要有空白；不要把 .env 傳給任何人。

# 凱基登入（身分證字號、密碼）
KGI_PERSON_ID=
KGI_PERSON_PWD=

# 要使用的帳號：請先執行一次 python -m trader.order_server，從錯誤訊息列出的帳號清單中挑選。
# 程式不會自動選第一個帳號。不用的市場留空。
KGI_TW_ACCOUNT=
KGI_US_ACCOUNT=

# 選填：固定配對碼（不填則每次啟動隨機產生 6 位數）
PAIR_CODE=

# 選填：LINE 通知（trader/settings 的 notify 使用）
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TO=
